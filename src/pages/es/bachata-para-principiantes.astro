---
import Layout from '../../layouts/Layout.astro';
import MailchimpForm from '../../components/MailchimpForm.astro';

const heroImage = '/images/heroes/320A0544.jpg';
const studioMap = 'https://maps.app.goo.gl/xcVgBXaMSCNxQQNAA';
// Coordenadas exactas del estudio con etiqueta, para que el marcador no se
// desplace a otro negocio de nombre parecido. output=embed no necesita clave.
const studioEmbed =
  'https://maps.google.com/maps?q=' +
  encodeURIComponent('28.2402308,-16.8375366 (Tenerife Movement Studio)') +
  '&z=16&hl=es&output=embed';
const whatsapp =
  'https://wa.me/34629178242?text=' +
  encodeURIComponent('¡Hola! Me gustaría unirme al grupo de bachata para principiantes de los lunes.');

const essentials = [
  { label: 'Cuándo', value: 'Lunes, 18:00–19:00', note: 'Primera clase: lunes 2 de noviembre' },
  { label: 'Dónde', value: 'Tenerife Movement Studio', note: 'Los Gigantes' },
  { label: 'Precio', value: '10€ por clase', note: '35€ por 4 · 50€ por pareja para 4' },
  { label: 'Para quién', value: 'Principiantes totales', note: 'Sin pareja' },
];

const firstWeeks = [
  {
    title: 'Escuchar el ritmo',
    body: 'Lo único que necesita todo bailarín. Aprenderás a reconocer el ritmo de una canción y a mantenerlo, para que la música haga la mitad del trabajo por ti.',
  },
  {
    title: 'El paso básico',
    body: 'La bachata se construye sobre un sencillo paso lateral. Lo vemos con calma, primero solo y después en pareja, hasta que deje de requerir tu atención.',
  },
  {
    title: 'Guiar y seguir',
    body: 'Cómo proponer un movimiento y cómo recibirlo: una conexión tranquila y cómoda en la que ambos se sienten bien, sea cual sea tu rol.',
  },
  {
    title: 'Tus primeras vueltas',
    body: 'Cuando el básico esté firme añadimos las primeras vueltas y cambios de lugar, los pocos movimientos que permiten bailar una canción entera.',
  },
];

const faqs = [
  {
    q: '¿Necesito pareja?',
    a: 'No. La mayoría viene sola. Durante la clase cambiamos de pareja, así bailas con todo el mundo y nadie se queda fuera.',
  },
  {
    q: 'Nunca he bailado. ¿De verdad no pasa nada?',
    a: 'Es justo para quien está pensado este grupo. Es un Nivel 0 completamente nuevo, así que todos empezamos el mismo día desde el mismo punto: el primer paso.',
  },
  {
    q: '¿Tengo que apuntarme a un curso completo?',
    a: 'No. Puedes pagar clase a clase por 10€. Si sabes que vendrás con regularidad, el bono de cuatro clases sale más barato: 35€, o 50€ por pareja.',
  },
  {
    q: '¿Qué me pongo?',
    a: 'Ropa cómoda para moverte y zapatos de suela lisa que te permitan girar; las zapatillas con mucho agarre castigan las rodillas. No hacen falta zapatos de baile.',
  },
  {
    q: '¿Qué edad tiene la gente de la clase?',
    a: 'De todo. En nuestros grupos hay gente de veinte a setenta años, y todo el mundo baila con todo el mundo.',
  },
  {
    q: '¿Y si falto una semana?',
    a: 'Pasa. Escríbenos y te contamos lo que vimos en el grupo, y retomas el lunes siguiente.',
  },
];
---

<Layout
  title="Clases de bachata para principiantes en Los Gigantes, Tenerife"
  description="Nuevo grupo de bachata para principiantes a partir del lunes 2 de noviembre. Lunes a las 18:00 en Tenerife Movement Studio, Los Gigantes. Sin pareja y sin experiencia previa. 10€ por clase."
  lang="es"
  hreflangEN="https://www.bailacanarias.com/beginners-bachata"
  hreflangES="https://www.bailacanarias.com/es/bachata-para-principiantes"
  lcpImage={heroImage}
  ogImage="/images/heroes/320A0544.jpg"
>
  <div class="page-header lp-hero" style={`--page-hero-img: url('${heroImage}');`}>
    <div class="container">
      <p class="lp-eyebrow">Empieza el lunes 2 de noviembre</p>
      <h1>Aprende a bailar bachata desde el primer paso</h1>
      <p>
        Un grupo nuevo para principiantes en Los Gigantes, todos los lunes por la tarde.
        Sin pareja, sin experiencia y sin presión.
      </p>
      <div class="lp-hero-actions">
        <a href={whatsapp} class="btn btn-primary" target="_blank" rel="noopener">
          Reserva tu plaza
        </a>
        <a href="#details" class="btn btn-outline">Ver los detalles</a>
      </div>
    </div>
  </div>

  <section class="section section--cream" id="details">
    <div class="container">
      <dl class="lp-essentials">
        {
          essentials.map((item) => (
            <div class="lp-essential">
              <dt>{item.label}</dt>
              <dd>
                <strong>{item.value}</strong>
                <span>{item.note}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="bio-content">
        <h2>Todo el mundo empieza a la vez</h2>
        <p style="font-size:1.15rem;">
          Lo más difícil de aprender a bailar es entrar por la puerta la primera vez. Este grupo
          está pensado para que eso sea fácil: es un Nivel 0 de verdad, que arranca desde cero el
          lunes 2 de noviembre, con una sala llena de gente que tampoco ha bailado bachata nunca.
        </p>
        <p>
          La bachata es el baile latino más agradecido para empezar. El paso básico dura cuatro
          tiempos y se aprende en una tarde, así que el resto del tiempo lo dedicas a lo que de
          verdad hace que bailar siente bien: la música, la conexión con tu pareja y la confianza
          para levantarte a bailar en una fiesta.
        </p>
        <p>
          Enseñamos bachata social con raíces en la música de la República Dominicana, combinando
          los estilos tradicional, moderno y sensual. Lo importante siempre es bailar cómodo con
          otra persona, no memorizar coreografías.
          <a href="/es/que-es-la-bachata/">Lee más sobre el origen de la bachata</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="section-header">
        <h2>Tus primeras semanas</h2>
        <p>Lo que vemos en el grupo una vez que arrancamos.</p>
      </div>
      <div class="lp-steps">
        {
          firstWeeks.map((step, i) => (
            <div class="lp-step">
              <span class="lp-step-num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="bio-content">
        <h2>Dónde encontrarnos</h2>
        <p>
          Las clases son en <strong>Tenerife Movement Studio</strong>, en Los Gigantes: una sala
          con suelo de baile y espejos, a cinco minutos del puerto
          (<a href={studioMap} target="_blank" rel="noopener">ver en el mapa</a>).
        </p>
        <iframe
          class="lp-map"
          src={studioEmbed}
          title="Mapa con la ubicación de Tenerife Movement Studio en Los Gigantes"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <p>
          Ven unos minutos antes tu primer lunes para que podamos saludarte con calma. Ayuda mucho
          que nos escribas antes: estaremos pendientes de ti en la puerta y te avisaremos si alguna
          vez hay un cambio de última hora.
        </p>
        <p>
          ¿Ya has bailado algo? El <a href="/es/aprende-a-bailar-con-nosotros/">grupo de Nivel 1</a>
          es justo después, a las 19:00 en la misma sala, y mucha gente se queda a las dos.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="bio-content">
        <h2 style="text-align:center;margin-bottom:2rem;">Preguntas frecuentes</h2>
        {
          faqs.map((faq) => (
            <div style="margin-bottom:1.75rem;">
              <h3 style="margin-bottom:0.5rem;">{faq.q}</h3>
              <p style="margin:0;">{faq.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Nos vemos el lunes</h2>
      <p>
        Escríbenos y te guardamos una plaza en el grupo nuevo.
        Es lo único que tienes que hacer antes de venir.
      </p>
      <div class="lp-cta-actions">
        <a href={whatsapp} class="btn btn-whatsapp" target="_blank" rel="noopener">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
          </svg>
          Escríbenos por WhatsApp
        </a>
        <a href="mailto:contact@bailacanarias.com" class="btn btn-outline-primary">Enviar un email</a>
      </div>
    </div>
  </section>

  <MailchimpForm lang="es" />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Course',
    'name': 'Bachata para principiantes, Nivel 0',
    'description':
      'Clase de bachata en grupo para principiantes en Los Gigantes, Tenerife. Lunes de 18:00 a 19:00 en Tenerife Movement Studio. Sin pareja ni experiencia previa.',
    'url': 'https://www.bailacanarias.com/es/bachata-para-principiantes/',
    'inLanguage': 'es',
    'educationalLevel': 'Principiante',
    'provider': {
      '@type': 'DanceSchool',
      'name': 'Baila Canarias',
      'url': 'https://www.bailacanarias.com',
      'telephone': '+34629178242',
      'email': 'contact@bailacanarias.com',
    },
    'hasCourseInstance': {
      '@type': 'CourseInstance',
      'courseMode': 'Onsite',
      'courseWorkload': 'PT1H',
      'location': {
        '@type': 'Place',
        'name': 'Tenerife Movement Studio',
        'address': {
          '@type': 'PostalAddress',
          'addressLocality': 'Los Gigantes',
          'addressRegion': 'Tenerife',
          'addressCountry': 'ES',
        },
      },
      'courseSchedule': {
        '@type': 'Schedule',
        'startDate': '2026-11-02',
        'repeatFrequency': 'P1W',
        'byDay': 'https://schema.org/Monday',
        'startTime': '18:00',
        'endTime': '19:00',
      },
    },
    'offers': {
      '@type': 'Offer',
      'price': '10',
      'priceCurrency': 'EUR',
      'category': 'Clase suelta',
      'availability': 'https://schema.org/InStock',
    },
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faqs.map((faq) => ({
      '@type': 'Question',
      'name': faq.q,
      'acceptedAnswer': { '@type': 'Answer', 'text': faq.a },
    })),
  })} />

  <style>
    /* ===== Hero ===== */
    /* The studio photo is bright and busy, so the flat 40% overlay is not enough
       to carry white text. A centre-weighted scrim darkens behind the copy while
       letting the faces at the edges stay visible. */
    .lp-hero {
      min-height: 500px;
      background-position: center 28%;
    }
    .lp-hero::after {
      background: radial-gradient(
        ellipse 80% 70% at 50% 50%,
        rgba(0, 0, 0, 0.74) 0%,
        rgba(0, 0, 0, 0.62) 45%,
        rgba(0, 0, 0, 0.42) 100%
      );
    }
    .lp-eyebrow {
      display: inline-block;
      margin: 0 0 1rem;
      padding: 0.35rem 0.9rem;
      border-radius: 999px;
      background: var(--color-primary);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      max-width: none;
    }
    .lp-hero h1 {
      max-width: 17ch;
      margin: 0 auto;
    }
    .lp-hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 1.75rem;
    }
    .lp-hero .container > * {
      animation: lp-rise 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) backwards;
    }
    .lp-hero .lp-eyebrow { animation-delay: 0.05s; }
    .lp-hero h1 { animation-delay: 0.15s; }
    .lp-hero p:not(.lp-eyebrow) { animation-delay: 0.25s; }
    .lp-hero-actions { animation-delay: 0.35s; }
    @keyframes lp-rise {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: none; }
    }

    /* ===== Essentials strip ===== */
    .lp-essentials {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem 2rem;
      margin: 0;
    }
    .lp-essential {
      padding-left: 1.1rem;
      border-left: 3px solid var(--color-primary);
    }
    .lp-essential dt {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-text-light);
      margin-bottom: 0.4rem;
    }
    .lp-essential dd {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .lp-essential dd strong {
      font-size: 1.15rem;
      line-height: 1.3;
      color: var(--color-heading);
    }
    .lp-essential dd span {
      font-size: 0.95rem;
      color: var(--color-text-light);
    }

    /* ===== First weeks ===== */
    .lp-steps {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 3rem;
      max-width: 900px;
      margin: 0 auto;
    }
    .lp-step {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }
    .lp-step-num {
      flex: 0 0 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      background: var(--color-primary);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1rem;
    }
    .lp-step h3 {
      margin: 0.15rem 0 0.4rem;
      font-size: 1.15rem;
    }
    .lp-step p {
      margin: 0;
      font-size: 0.97rem;
    }

    /* ===== Map ===== */
    .lp-map {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      border: 0;
      border-radius: 8px;
      margin: 1.75rem 0;
    }

    /* ===== CTA ===== */
    .lp-cta-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .btn-whatsapp {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: #25d366;
      color: #fff;
      border-color: #25d366;
    }
    .btn-whatsapp:hover {
      background: #1da851;
      border-color: #1da851;
      color: #fff;
    }

    @media (max-width: 900px) {
      .lp-essentials {
        grid-template-columns: repeat(2, 1fr);
      }
      .lp-steps {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 520px) {
      .lp-essentials {
        grid-template-columns: 1fr;
      }
      .lp-hero h1 {
        max-width: none;
      }
      /* Keep the date badge on a single line at phone width */
      .lp-eyebrow {
        font-size: 0.72rem;
        letter-spacing: 0.06em;
      }
      /* 16:9 is too letterboxed to read on a phone */
      .lp-map {
        aspect-ratio: 4 / 3;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .lp-hero .container > * {
        animation: none;
      }
    }
  </style>
</Layout>
