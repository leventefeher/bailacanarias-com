---
import Layout from '../layouts/Layout.astro';
import MailchimpForm from '../components/MailchimpForm.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const data = await reader.singletons.whereToDance.read();
const parties = data?.parties ?? [];

// One-off events are pruned by scripts/parties/update-parties.mjs, but filter
// again at build time so a stale deploy never shows a party that already happened.
// Region travels as a code so each language prints it natively.
const REGIONS: Record<string, { en: string; es: string }> = {
  north: { en: 'Tenerife North', es: 'Tenerife Norte' },
  south: { en: 'Tenerife South', es: 'Tenerife Sur' },
  east: { en: 'Tenerife East', es: 'Tenerife Este' },
  west: { en: 'Tenerife West', es: 'Tenerife Oeste' },
  northeast: { en: 'Tenerife Northeast', es: 'Tenerife Noreste' },
  northwest: { en: 'Tenerife Northwest', es: 'Tenerife Noroeste' },
  southeast: { en: 'Tenerife Southeast', es: 'Tenerife Sureste' },
  southwest: { en: 'Tenerife Southwest', es: 'Tenerife Suroeste' },
};
const regionLabel = (code: string, lang: 'en' | 'es') =>
  REGIONS[(code ?? '').trim().toLowerCase()]?.[lang] ?? '';

const placeLabel = (location: string, region: string, lang: 'en' | 'es') =>
  [location, regionLabel(region, lang)].filter(Boolean).join(' — ');

// When these listings last actually CHANGED, not when the site was built or
// when the sources were last checked. Written into the YAML by
// scripts/parties/update-parties.mjs only on a run that altered the content.
const modified = data?.lastModified ? new Date(data.lastModified) : null;
const lastUpdated = (modified && !isNaN(modified.valueOf()) ? modified : new Date()).toLocaleString(
  'en-GB',
  {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'Atlantic/Canary',
  }
);

const todayIso = new Date().toISOString().slice(0, 10);
const oneOffEvents = (data?.oneOffEvents ?? [])
  .filter((e) => (e.date ?? '') >= todayIso)
  .sort((a, b) => (a.date ?? '').localeCompare(b.date ?? ''));

// One day-group per DATE, not per event: several parties often share a night
// and the date heading should print once above them, like the weekly list.
const oneOffDays = [
  ...oneOffEvents.reduce((days, event) => {
    if (!days.has(event.date)) days.set(event.date, []);
    days.get(event.date).push(event);
    return days;
  }, new Map<string, typeof oneOffEvents>()),
];

const formatEventDate = (iso: string, locale: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString(locale, {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
  });

// Parse "Name | Location | Styles EN | Styles ES | URL (optional)" lines into event objects
function parseEvents(raw: string) {
  return raw
    .split('\n')
    .map((line) => line.trim())
    .filter(Boolean)
    .map((line) => {
      const [
        name = '',
        location = '',
        stylesEn = '',
        stylesEs = '',
        url = '',
        mapsUrl = '',
        region = '',
      ] = line.split('|').map((s) => s.trim());
      return { name, location, stylesEn, stylesEs, url, mapsUrl, region };
    });
}
---

<Layout
  title="Where to Social Dance SBK in Tenerife"
  description="Find the best weekly salsa, bachata and kizomba social dance nights across Tenerife. An up-to-date guide to SBK parties in the Canary Islands."
  lang="en"
  hreflangEN="https://www.bailacanarias.com/where-to-dance-in-tenerife"
  hreflangES="https://www.bailacanarias.com/es/donde-bailar-sbk-in-tenerife-salsa-bachata-kizomba"
  lcpImage={data?.heroImage ?? '/images/2024/01/320A0372.jpg'}
>
  <div
    class="page-header"
    style={`--page-hero-img: url('${data?.heroImage ?? '/images/2024/01/320A0372.jpg'}')`}
  >
    <div class="container">
      <h1>Where to social dance SBK in Tenerife?</h1>
      <p>Salsa, Bachata &amp; Kizomba parties across the island</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <p style="font-size:1.05rem;max-width:700px;margin-bottom:0.75rem;">
        {data?.introEn}
      </p>
      <p style="max-width:700px;margin-bottom:3rem;font-style:italic;color:var(--color-text);">
        {data?.noteEn} If you would like to learn to dance, check out our
        <a href="/dance-with-us/">dance classes and courses</a>.
      </p>

      <p class="freshness">
        Parties are often announced on the day, so it is worth checking back regularly.{' '}
        <span class="freshness-stamp">Last updated {lastUpdated}</span>
      </p>

      {
        oneOffEvents.length > 0 && (
          <>
            <h2 style="margin-bottom:1.5rem;">
              Upcoming one-off events{' '}
              <a href="#weekly" class="heading-aside">
                (see weekly events further down)
              </a>
            </h2>
            <div class="parties-list" style="margin-bottom:3rem;">
              {oneOffDays.map(([date, events]) => (
                <div class="day-group">
                  <div class="day-label">{formatEventDate(date, 'en-GB')}</div>
                  {events.map((event) => (
                    <div class="party-item">
                      {event.url ? (
                        <a href={event.url} class="party-name" target="_blank" rel="noopener">
                          {event.name}
                        </a>
                      ) : (
                        <span class="party-name">{event.name}</span>
                      )}
                      {(event.location || event.region || event.mapsUrl) && (
                        <span class="party-location">
                          <span class="party-place">
                            {placeLabel(event.location, event.region, 'en')}
                          </span>
                          {event.mapsUrl && (
                            <a
                              href={event.mapsUrl}
                              class="party-map"
                              target="_blank"
                              rel="noopener"
                            >
                              Map
                            </a>
                          )}
                        </span>
                      )}
                      {event.stylesEn && <span class="party-styles">{event.stylesEn}</span>}
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </>
        )
      }

      <h2
        id="weekly"
        style="margin-bottom:1.5rem;scroll-margin-top:calc(var(--header-height) + 1rem);"
      >
        Weekly Dance Parties
      </h2>

      <div class="parties-with-sidebar">
        <div class="parties-list">
          {
            parties.map((group) => {
              // The day note is a stand-in for an empty day ("Check Instagram for
              // Saturday events"), so it is suppressed as soon as that day has
              // one — otherwise it contradicts the listing below it.
              const events = parseEvents(group.eventsRaw ?? '');
              return (
                <div class="day-group">
                  <div class="day-label">{group.dayEn}</div>
                  {events.length === 0 && group.dayNoteEn && <p>{group.dayNoteEn}</p>}
                  {events.map((event) => (
                    <div class="party-item">
                      {event.url ? (
                        <a href={event.url} class="party-name" target="_blank" rel="noopener">
                          {event.name}
                        </a>
                      ) : (
                        <span class="party-name">{event.name}</span>
                      )}
                      <span class="party-location">
                        <span class="party-place">
                          {placeLabel(event.location, event.region, 'en')}
                        </span>
                        {event.mapsUrl && (
                          <a href={event.mapsUrl} class="party-map" target="_blank" rel="noopener">
                            Map
                          </a>
                        )}
                      </span>
                      <span class="party-styles">{event.stylesEn}</span>
                    </div>
                  ))}
                </div>
              );
            })
          }
        </div>

        <aside class="parties-sidebar">
          <h3 style="margin-bottom:0.75rem;">Stay up to date</h3>
          <p style="margin-bottom:0.75rem;">
            Follow us on Instagram for the most up-to-date parties and socials in Tenerife. There
            are also many additional ad-hoc events. Check
            <a href="https://www.instagram.com/bailacanarias" target="_blank" rel="noopener"
              >Sociales en Tenerife</a
            >
            for the latest.
          </p>
          <p style="margin-bottom:1rem;">
            Looking to dance in Gran Canaria? Check out
            <a href="https://www.livegrancanaria.com" target="_blank" rel="noopener"
              >Live Gran Canaria</a
            >.
          </p>
          <a
            href="https://www.instagram.com/bailacanarias"
            target="_blank"
            rel="noopener"
            class="btn btn-primary">Follow on Instagram</a
          >
        </aside>
      </div>
    </div>
  </section>

  <MailchimpForm lang="en" />
</Layout>
