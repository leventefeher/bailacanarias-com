---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found"
  description="The page you were looking for could not be found."
  lang="en"
>
  <div class="page-header">
    <div class="container">
      <h1>Page not found</h1>
      <p>The page you were looking for doesn't exist or has moved.</p>
    </div>
  </div>

  <section class="section">
    <div class="container" style="text-align:center;max-width:600px;margin:0 auto;">
      <p style="font-size:1.1rem;margin-bottom:2rem;">
        Sorry about that. Head back to the homepage or explore what we offer.
      </p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href="/" class="btn btn-primary">Go to homepage</a>
        <a href="/dance-with-us/" class="btn btn-outline-primary">See our classes</a>
      </div>
    </div>
  </section>
</Layout>
